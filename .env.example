# Aplikasi ini TIDAK memakai API berbayar maupun API key pihak ketiga.
# Untuk pengembangan lokal dengan `npm run pages:dev`, salin file ini menjadi `.dev.vars`
# (bukan `.env`) lalu isi nilainya. Di Cloudflare Pages, isi tiga nilai ini pada
# Settings -> Variables and Secrets (jenis "Secret").
TEACHER_USERNAME="ganti-username-guru"
TEACHER_PASSWORD="ganti-kata-sandi-guru-yang-kuat"
TEACHER_SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
